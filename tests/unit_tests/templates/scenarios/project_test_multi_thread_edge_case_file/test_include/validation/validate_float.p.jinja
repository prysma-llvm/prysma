fn bool testFloatComparisonChain()
{
    dec float a = 5.0;
    dec float b = 10.0;
    dec float c = 5.0;
    dec bool ab = call isLessFloat(a, b);
    {{ assert_eq(true, "ab", trace_positions=62) }}
    dec bool bc = call isGreaterFloat(b, c);
    {{ assert_eq(true, "bc", trace_positions=64) }}
    dec bool ac = call isEqualFloat(a, c);
    {{ assert_eq(true, "ac", trace_positions=66) }}
    if (ab == true) {
        if (bc == true) {
            if (ac == true) {
                return true;
            }
        }
    }
    return false;
}

fn void runFloatTests()
{
    dec bool outcome_testequalfloat = call testEqualFloat();
    {{ assert_eq(true, "outcome_testequalfloat", trace_positions=52) }}
    dec bool outcome_testnotequalfloat = call testNotEqualFloat();
    {{ assert_eq(true, "outcome_testnotequalfloat", trace_positions=54) }}
    dec bool outcome_testgreaterfloat = call testGreaterFloat();
    {{ assert_eq(true, "outcome_testgreaterfloat", trace_positions=57) }}
    dec bool outcome_testlessfloat = call testLessFloat();
    {{ assert_eq(true, "outcome_testlessfloat", trace_positions=60) }}
    dec bool outcome_testfloatcomparisonchain = call testFloatComparisonChain();
    {{ assert_eq(true, "outcome_testfloatcomparisonchain", trace_positions=67) }}
}
