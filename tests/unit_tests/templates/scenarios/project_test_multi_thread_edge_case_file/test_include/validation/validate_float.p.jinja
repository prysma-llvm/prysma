fn bool testEqualFloat()
{
    dec bool r = call isEqualFloat(3.14, 3.14);
    {{ assert_eq(1, true, "r", at=51) }}
    if (r == true) {
        return true;
    }
    return false;
}

fn bool testNotEqualFloat()
{
    dec bool r = call isEqualFloat(1.0, 2.0);
    {{ assert_eq(2, false, "r", at=53) }}
    if (r == false) {
        return true;
    }
    return false;
}

fn bool testGreaterFloat()
{
    dec bool r = call isGreaterFloat(9.5, 2.3);
    {{ assert_eq(3, true, "r", at=56) }}
    if (r == true) {
        return true;
    }
    return false;
}

fn bool testLessFloat()
{
    dec bool r = call isLessFloat(0.5, 1.0);
    {{ assert_eq(4, true, "r", at=59) }}
    if (r == true) {
        return true;
    }
    return false;
}

fn bool testFloatComparisonChain()
{
    dec float a = 5.0;
    dec float b = 10.0;
    dec float c = 5.0;
    dec bool ab = call isLessFloat(a, b);
    {{ assert_eq(5, true, "ab", at=62) }}
    dec bool bc = call isGreaterFloat(b, c);
    {{ assert_eq(6, true, "bc", at=64) }}
    dec bool ac = call isEqualFloat(a, c);
    {{ assert_eq(7, true, "ac", at=66) }}
    if (ab == true) {
        if (bc == true) {
            if (ac == true) {
                return true;
            }
        }
    }
    return false;
}

fn void runFloatTests()
{
    dec bool outcome_testequalfloat = call testEqualFloat();
    {{ assert_eq(8, true, "outcome_testequalfloat", at=52) }}
    dec bool outcome_testnotequalfloat = call testNotEqualFloat();
    {{ assert_eq(9, true, "outcome_testnotequalfloat", at=54) }}
    dec bool outcome_testgreaterfloat = call testGreaterFloat();
    {{ assert_eq(10, true, "outcome_testgreaterfloat", at=57) }}
    dec bool outcome_testlessfloat = call testLessFloat();
    {{ assert_eq(11, true, "outcome_testlessfloat", at=60) }}
    dec bool outcome_testfloatcomparisonchain = call testFloatComparisonChain();
    {{ assert_eq(12, true, "outcome_testfloatcomparisonchain", at=67) }}
}
