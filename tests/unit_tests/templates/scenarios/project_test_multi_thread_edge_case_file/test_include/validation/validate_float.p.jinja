fn bool testEqualFloat()
{
    dec bool r = call isEqualFloat(3.14, 3.14);
    {{ assert_eq(true, "r", trace_positions=51) }}
    if (r == true) {
        return true;
    }
    return false;
}

fn bool testNotEqualFloat()
