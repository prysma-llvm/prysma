include "addition.p";
include "subtraction.p";
include "multiplication.p";

fn bool testAddition()
{
    dec int32 r = call add(10, 20);
    {{ assert_eq(1, 30, "r", at=2) }}
    if (r == 30) {
        return true;
    }
    return false;
}

fn bool testSubtraction()
{
    dec int32 r = call subtract(50, 25);
    {{ assert_eq(2, 25, "r", at=5) }}
    if (r == 25) {
        return true;
    }
    return false;
}

fn bool testMultiplication()
{
    dec int32 r = call multiply(6, 7);
    {{ assert_eq(3, 42, "r", at=8) }}
    if (r == 42) {
        return true;
    }
    return false;
}

fn bool testAdditionFloat()
{
    dec float r = call addFloat(1.5, 2.5);
    {{ assert_eq(4, 4.0, "r", at=11) }}
    if (r == 4.0) {
        return true;
    }
    return false;
}

fn bool testSubtractionFloat()
{
    dec float r = call subtractFloat(10.0, 3.5);
    {{ assert_eq(5, 6.5, "r", at=14) }}
    if (r == 6.5) {
        return true;
    }
    return false;
}

fn bool testMultiplicationFloat()
{
    dec float r = call multiplyFloat(2.5, 4.0);
    {{ assert_eq(6, 10.0, "r", at=17) }}
    if (r == 10.0) {
        return true;
    }
    return false;
}

fn bool testCombinedExpression()
{
    dec int32 a = call add(5, 3);
    {{ assert_eq(7, 8, "a", at=20) }}
    dec int32 b = call multiply(a, 2);
    {{ assert_eq(8, 16, "b", at=22) }}
    dec int32 c = call subtract(b, 6);
    {{ assert_eq(9, 10, "c", at=24) }}
    if (c == 10) {
        return true;
    }
    return false;
}

fn void runMathTests()
{
    dec bool outcome_testaddition = call testAddition();
    {{ assert_eq(10, true, "outcome_testaddition", at=3) }}
    dec bool outcome_testsubtraction = call testSubtraction();
    {{ assert_eq(11, true, "outcome_testsubtraction", at=6) }}
    dec bool outcome_testmultiplication = call testMultiplication();
    {{ assert_eq(12, true, "outcome_testmultiplication", at=9) }}
    dec bool outcome_testadditionfloat = call testAdditionFloat();
    {{ assert_eq(13, true, "outcome_testadditionfloat", at=12) }}
    dec bool outcome_testsubtractionfloat = call testSubtractionFloat();
    {{ assert_eq(14, true, "outcome_testsubtractionfloat", at=15) }}
    dec bool outcome_testmultiplicationfloat = call testMultiplicationFloat();
    {{ assert_eq(15, true, "outcome_testmultiplicationfloat", at=18) }}
    dec bool outcome_testcombinedexpression = call testCombinedExpression();
    {{ assert_eq(16, true, "outcome_testcombinedexpression", at=25) }}
}
