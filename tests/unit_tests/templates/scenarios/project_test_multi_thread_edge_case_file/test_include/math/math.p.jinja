include "addition.p";
include "subtraction.p";
include "multiplication.p";

fn bool testAddition()
{
    dec int32 r = call add(10, 20);
    {{ assert_eq(30, "r", trace_positions=2) }}
    if (r == 30) {
        return true;
    }
    return false;
}

fn bool testSubtraction()
{
    dec int32 r = call subtract(50, 25);
    {{ assert_eq(25, "r", trace_positions=5) }}
    if (r == 25) {
        return true;
    }
    return false;
}

fn bool testMultiplication()
{
    dec int32 r = call multiply(6, 7);
    {{ assert_eq(42, "r", trace_positions=8) }}
    if (r == 42) {
        return true;
    }
    return false;
}

fn bool testAdditionFloat()
{
    dec float r = call addFloat(1.5, 2.5);
    {{ assert_eq(4.0, "r", trace_positions=11) }}
    if (r == 4.0) {
        return true;
    }
    return false;
}

fn bool testSubtractionFloat()
{
    dec float r = call subtractFloat(10.0, 3.5);
    {{ assert_eq(6.5, "r", trace_positions=14) }}
    if (r == 6.5) {
        return true;
    }
    return false;
}

fn bool testMultiplicationFloat()
{
    dec float r = call multiplyFloat(2.5, 4.0);
    {{ assert_eq(10.0, "r", trace_positions=17) }}
    if (r == 10.0) {
        return true;
    }
    return false;
}

fn bool testCombinedExpression()
{
    dec int32 a = call add(5, 3);
    {{ assert_eq(8, "a", trace_positions=20) }}
    dec int32 b = call multiply(a, 2);
    {{ assert_eq(16, "b", trace_positions=22) }}
    dec int32 c = call subtract(b, 6);
    {{ assert_eq(10, "c", trace_positions=24) }}
    if (c == 10) {
        return true;
    }
    return false;
}

fn void runMathTests()
{
    dec bool outcome_testaddition = call testAddition();
    {{ assert_eq(true, "outcome_testaddition", trace_positions=3) }}
    dec bool outcome_testsubtraction = call testSubtraction();
    {{ assert_eq(true, "outcome_testsubtraction", trace_positions=6) }}
    dec bool outcome_testmultiplication = call testMultiplication();
    {{ assert_eq(true, "outcome_testmultiplication", trace_positions=9) }}
    dec bool outcome_testadditionfloat = call testAdditionFloat();
    {{ assert_eq(true, "outcome_testadditionfloat", trace_positions=12) }}
    dec bool outcome_testsubtractionfloat = call testSubtractionFloat();
    {{ assert_eq(true, "outcome_testsubtractionfloat", trace_positions=15) }}
    dec bool outcome_testmultiplicationfloat = call testMultiplicationFloat();
    {{ assert_eq(true, "outcome_testmultiplicationfloat", trace_positions=18) }}
    dec bool outcome_testcombinedexpression = call testCombinedExpression();
    {{ assert_eq(true, "outcome_testcombinedexpression", trace_positions=25) }}
}
