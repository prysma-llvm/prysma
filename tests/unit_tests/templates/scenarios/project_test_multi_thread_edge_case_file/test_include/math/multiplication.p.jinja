fn int32 multiply(arg int32 a, arg int32 b)
{
    dec int32 result = a * b;
    {{ assert_eq(1, [42, 16], "result", at=[7, 21]) }}
    return result;
}

fn float multiplyFloat(arg float a, arg float b)
{
    dec float result = a * b;
    {{ assert_eq(2, 10.0, "result", at=16) }}
    return result;
