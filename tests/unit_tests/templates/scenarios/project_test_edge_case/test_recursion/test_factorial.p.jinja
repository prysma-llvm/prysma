fn int32 factorial(arg int32 n)
{
   {{ assert_eq(1, [5, 4, 3, 2, 1], "n", at=[1, 2, 3, 4, 5]) }}
   if (n <= 1) {
      {{ checkpoint(2, at=6) }}
      return 1;
   }
   dec int32 m = n - 1;
   dec int32 r = call factorial(m);
   dec int32 computed = n * r;
   {{ assert_eq(3, [[2, 2], [3, 6], [4, 24], [5, 120]], ["n", "computed"], at=[7, 8, 9, 10]) }}
   return computed;
}

fn bool testFactorial()
{
   dec int32 result = call factorial(5);
   {{ assert_eq(4, 120, "result", at=11) }}
   if (result == 120) {
      {{ checkpoint(5, at=12) }}
      return true;
   } else {
      {{ checkpoint(6, at=[]) }}
      return false;
   }
   return false;
}

fn int32 main() {
    dec bool outcome = call testFactorial();
    {{ assert_eq(7, true, "outcome", at=13) }}
    return 0;
}
