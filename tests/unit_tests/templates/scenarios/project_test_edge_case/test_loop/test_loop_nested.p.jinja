{# The outer event precedes five inner events on each pass. #}
{% set outer_states, outer_events = [], [] -%}
{% set inner_states, inner_events = [], [] -%}
{% for i in range(5) -%}
    {% set _ = outer_states.append([i, 0, i * 5]) -%}
    {% set _ = outer_events.append(2 + i * 6) -%}
    {% for j in range(1, 6) -%}
        {% set _ = inner_states.append([i, j, i * 5 + j]) -%}
        {% set _ = inner_events.append(2 + i * 6 + j) -%}
    {% endfor -%}
{% endfor -%}
fn bool testLoopNested()
{
    dec int32 i = 0; dec int32 j = 0; dec int32 total = 0;
    {{ assert_eq([0, 0, 0], ["i", "j", "total"], trace_positions=1) }}
    while(i < 5) {
        aff j = 0;
        {{ assert_eq(outer_states, ["i", "j", "total"], trace_positions=outer_events) }}
        while(j < 5) {
            aff total = total + 1;
            aff j = j + 1;
            {{ assert_eq(inner_states, ["i", "j", "total"], trace_positions=inner_events) }}
        }
        aff i = i + 1;
    }
    {{ assert_eq([5, 5, 25], ["i", "j", "total"], trace_positions=32) }}
    if(total == 25) {
        {{ checkpoint(trace_positions=33) }}
        return true;
    }
    {{ checkpoint(trace_positions=[]) }}
    return false;
}
fn int32 main() {
    dec bool outcome = call testLoopNested();
    {{ assert_eq(true, "outcome", trace_positions=34) }}
    return 0;
}
