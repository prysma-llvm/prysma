    while(condition) {
        aff i = i + 1;
        aff condition = i < 5;
        {{ assert_eq([[1, true], [2, true], [3, true], [4, true], [5, false]], ["i", "condition"], trace_positions=[2, 3, 4, 5, 6]) }}
    }
    {{ assert_eq([5, false], ["i", "condition"], trace_positions=7) }}
    if (i == 5) {
        {{ checkpoint(trace_positions=8) }}
        return true;
    }
    {{ checkpoint(trace_positions=[]) }}
    return false;
}
fn int32 main() {
    dec bool outcome = call testLoopConditionExternal();
