fn bool testLoopConditionComplex()
{
    dec int32 i = 0; dec int32 j = 10;
    {{ assert_eq([0, 10], ["i", "j"], trace_positions=1) }}
    while(i < 5 && j > 5) {
        aff i = i + 1;
        aff j = j - 1;
        {{ assert_eq([[1, 9], [2, 8], [3, 7], [4, 6], [5, 5]], ["i", "j"], trace_positions=[2, 3, 4, 5, 6]) }}
    }
    {{ assert_eq([5, 5], ["i", "j"], trace_positions=7) }}
    if(i == 5 && j == 5) {
        {{ checkpoint(trace_positions=8) }}
        return true;
    }
    {{ checkpoint(trace_positions=[]) }}
    return false;
}
fn int32 main() {
    dec bool outcome = call testLoopConditionComplex();
    {{ assert_eq(true, "outcome", trace_positions=9) }}
