{% set cases = [
    [7, 3, 2, 1],
    [-7, 3, -2, -1],
    [7, -3, -2, 1],
    [-7, -3, 2, -1],
    [3, -7, 0, 3],
    [-6, 3, -2, 0],
    [0, -3, 0, 0]
] -%}
{% set types = ['int32', 'int64'] -%}

{% for type_name in types %}
fn void checkDivision_{{ type_name }}(arg {{ type_name }} dividend, arg {{ type_name }} divisor) {
    dec {{ type_name }} quotient = dividend / divisor;
    dec {{ type_name }} remainder = dividend % divisor;
    {{ assert_eq(loop.index, cases, ["dividend", "divisor", "quotient", "remainder"],
                 at=range(loop.index0 * (cases|length) + 1, loop.index * (cases|length) + 1)|list) }}
}
{% endfor %}

fn int32 main() {
    {% for type_name in types %}
        {% for dividend, divisor, quotient, remainder in cases %}
    call checkDivision_{{ type_name }}({{ dividend }}, {{ divisor }});
        {% endfor %}
    {% endfor %}

    dec int64 wide = 8589934595;
    dec int64 divisor = 2;
    dec int64 quotient = wide / divisor;
    dec int64 remainder = wide % divisor;
    // Split the 64-bit quotient because print uses a 32-bit integer format.
    {{ assert_eq(3, [1, 1, 1], ["quotient / 4294967296", "quotient % 4294967296", "remainder"],
                 at=(types|length) * (cases|length) + 1) }}

    return 0;
}
