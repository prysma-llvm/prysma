fn bool testStateUpdate_{{ type_name }}()
{
   dec {{ type_name }} a = {{ val_1 }};
   dec {{ type_name }} b = {{ val_5 }};
   {{ assert_eq([typed(1), typed(5)], ["a", "b"], trace_positions=1) }}

   aff a = {{ val_10 }}; 
   {{ assert_eq(typed(10), "a", trace_positions=2) }}

   dec {{ type_name }} c = a + b;
   {{ assert_eq(typed(15), "c", trace_positions=3) }}
   if (c == {{ val_15 }}) {
      {{ checkpoint(trace_positions=4) }}
      return true;
   } else {
      {{ checkpoint(trace_positions=[]) }}
      return false;
   }

   return false;
}

fn int32 main()
{
    dec bool outcome = call testStateUpdate_{{ type_name }}();
    {{ assert_eq(true, "outcome", trace_positions=5) }}
    return 0;
}
