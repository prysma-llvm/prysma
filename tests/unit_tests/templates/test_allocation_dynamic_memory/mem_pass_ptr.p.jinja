fn bool verify_{{ type_name }}(arg ptr pointer)
{
   dec {{ type_name }} value = unref pointer;
   {{ assert_eq(typed(50), "value", trace_positions=1) }}
   if (value == {{ val_50 }}) {
      {{ checkpoint(trace_positions=2) }}
      return true;
   } else {
      {{ checkpoint(trace_positions=[]) }}
      return false;
   }
   return false;
}

fn bool testPassPtrByArgument_{{ type_name }}()
{
   dec ptr p = new {{ type_name }};
   aff p = {{ val_50 }};
   dec bool result = call verify_{{ type_name }}(p);
   delete p;
   {{ assert_eq(true, "result", trace_positions=3) }}
   if (result == true) {
      {{ checkpoint(trace_positions=4) }}
      return true;
   } else {
      {{ checkpoint(trace_positions=[]) }}
      return false;
   }
   return false;
}

fn int32 main() {
    dec bool outcome = call testPassPtrByArgument_{{ type_name }}();
    {{ assert_eq(true, "outcome", trace_positions=5) }}
    return 0;
}
