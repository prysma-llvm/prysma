{% for op in combinations %}
fn bool test_{{ op.id }}() {
    dec {{ type_name }} l = {{ op.left }};
    dec {{ type_name }} r = {{ op.right }};
    dec {{ type_name }} res = l {{ op.op }} r;
    {{ assert_eq(loop.index, op.exp|from_json, "res", at=loop.index0 * 2 + 1) }}
    if (res != {{ op.exp }}) {
        return false;
    }
    return true;
}

{% endfor %}

fn int32 main() {

    {% for op in combinations %}
    if (call test_{{ op.id }}() == false) {
        return 1;
    }
    {{ checkpoint((combinations|length) + loop.index, at=loop.index * 2) }}
    {% endfor %}

    return 0;
}
