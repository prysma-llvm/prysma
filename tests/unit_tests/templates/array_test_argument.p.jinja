fn bool arrayInjectionArgument_{{ type_name }}(arg {{ type_name }}[3] array)
{
    {{ assert_eq([typed(1), typed(0), typed(1)], ["array[0]", "array[1]", "array[2]"], trace_positions=2) }}
    if (array[0] != {{ val1 }}) {
        return false;
    }
    if (array[1] != {{ val2 }}) {
        return false;  
    }
    if (array[2] != {{ val1 }}) {
        return false;  
    }
    return true;
}

fn bool arrayTestArgument_{{ type_name }}()
{
    dec {{ type_name }}[3] array = [{{ val1 }}, {{ val2 }}, {{ val1 }}];
    {{ assert_eq([typed(1), typed(0), typed(1)], ["array[0]", "array[1]", "array[2]"], trace_positions=1) }}
    return call arrayInjectionArgument_{{ type_name }}(array);
}

fn int32 main()
{
    dec bool outcome = call arrayTestArgument_{{ type_name }}();
    {{ assert_eq(true, "outcome", trace_positions=3) }}
    return 0;
}
