fn bool arrayTestStackIntegrity_{{ type_name }}()
{
    dec {{ type_name }} a = {{ val1 }};
    dec {{ type_name }}[2] t = [{{ val2 }}, {{ val2 }}];
    dec {{ type_name }} b = {{ val2 }};
    {{ assert_eq(1, [typed(1), typed(0), typed(0), typed(0)], ["a", "t[0]", "t[1]", "b"]) }}

    aff t[0] = {{ val1 }};
    aff t[1] = {{ val1 }};
    {{ assert_eq(2, [typed(1), typed(1), typed(1), typed(0)], ["a", "t[0]", "t[1]", "b"]) }}

    if (a != {{ val1 }}) { return false; }
    if (b != {{ val2 }}) { return false; }
    return true;
}

fn int32 main()
{
    dec bool outcome = call arrayTestStackIntegrity_{{ type_name }}();
    {{ assert_eq(3, true, "outcome") }}
    return 0;
}
