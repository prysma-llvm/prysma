// This tests boolean logic operators and simple expressions

fn bool test_logic() {
    dec bool a = true;
    dec bool b = false;
    {{ assert_eq(1, [true, false], ["a", "b"]) }}

    // Direct Evaluation
    if ((a && b) == true) {
        return false;
    }

    {{ checkpoint(2) }}

    if ((a || b) == false) {
        return false;
    }

    {{ checkpoint(3) }}

    // Complex Parenthesis combinations
    if ((a || false) && (b || true)) {
    {{ checkpoint(4) }}
        return true;
    }

    return false;
}

fn int32 main() {

    // Only run the test if bool
    {% if type_name == "bool" %}

    if (call test_logic() == false) {
        return 1;
    }

    {{ checkpoint(5) }}
    {% endif %}

    return 0;
}
