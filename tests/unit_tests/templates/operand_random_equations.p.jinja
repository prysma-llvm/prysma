{% for eq in equations %}
fn bool test_eq_{{ eq.id }}() {
    dec {{ type_name }} res = {{ eq.expression }};
    {{ assert_eq(loop.index, eq.expected|from_json, "res", at=loop.index0 * 2 + 1) }}
    if (res != {{ eq.expected }}) {
        return false;
    }
    return true;
}

{% endfor %}

fn int32 main() {

    {% for eq in equations %}
    if (call test_eq_{{ eq.id }}() == false) {
        return 1;
    }
    {{ checkpoint((equations|length) + loop.index, at=loop.index * 2) }}
    {% endfor %}

    return 0;
}
