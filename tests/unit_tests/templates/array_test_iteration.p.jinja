fn bool arrayTestIteration_{{ type_name }}()
{
    dec {{ type_name }}[3] t = [{{ val2 }}, {{ val2 }}, {{ val2 }}];
    dec int32 i = 0;
    {{ assert_eq(0, "i", trace_positions=1) }}

    while (i < 3) {
        aff t[i] = {{ val1 }};
        {{ assert_eq([[0, typed(1)], [1, typed(1)], [2, typed(1)]], ["i", "t[i]"], trace_positions=[2, 3, 4]) }}
        aff i = i + 1;
    }

    aff i = 0;
    {{ assert_eq(0, "i", trace_positions=5) }}
    while (i < 3) {
        {{ assert_eq([[0, typed(1)], [1, typed(1)], [2, typed(1)]], ["i", "t[i]"], trace_positions=[6, 7, 8]) }}
        if(t[i] != {{ val1 }})
        {
            return false;
        }
        aff i = i + 1;
    }

    return true;
}

fn int32 main()
{
    dec bool outcome = call arrayTestIteration_{{ type_name }}();
    {{ assert_eq(true, "outcome", trace_positions=9) }}
    return 0;
}
