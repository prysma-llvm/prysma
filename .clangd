# Prysma — strict config for clangd
# The actual build flags are provided
# by CMake via build/compile_commands.json.

CompileFlags:
  CompilationDatabase: build

  Add:
    # Include paths come from the compilation database. Relative paths here
    # would otherwise resolve against each compilation working directory.

    # Strict C++ diagnostics
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wshadow
    - -Wconversion
    - -Wsign-conversion
    - -Wnull-dereference

Index:
  Background: Build
  StandardLibrary: true

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

  ClangTidy:
    Add:
      - bugprone-*
      - performance-*
      - cert-*
      - clang-analyzer-*
      - concurrency-*

    Remove:
      - bugprone-easily-swappable-parameters

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  Designators: true
  TypeNameLimit: 0
  BlockEnd: true

Hover:
  ShowAKA: true

Completion:
  AllScopes: true