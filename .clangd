---
# Configuration globale pour Prysma
InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  Designators: true       
  TypeNameLimit: 0
  BlockEnd: true

CompileFlags:
  Add: 
    - "-Iinclude"
    - "-Ibuild/generationCode/include"
    - "-I.clangd-includes"
    - "-isystem.clangd-includes"
    - "-I.clangd-includes/llvm-18"
    - "-isystem.clangd-includes/llvm-18"
    - "-I.clangd-includes/llvm-c-18"
    - "-isystem.clangd-includes/llvm-c-18"
    - "-Itests/lib"
    - "-Itests/unit_tests/include"
    - "-fno-rtti" 
    - "-frtti"
    - "-std=c++23"
    - "-Wall"
    - "-Wextra"
    - "-Wpedantic"
    - "-Wshadow"
    - "-Wconversion"
    - "-Wsign-conversion"
    - "-Wnull-dereference"
    - "-fcolor-diagnostics"
    - "-Wno-deprecated-declarations"
    - "-Wno-unknown-warning-option"
    - "-Wno-unused-command-line-argument"
  Remove:
    - "-fsanitize=*"
    - "-fstack-protector*"
  CompilationDatabase: build

Index:
  Background: Build

Diagnostics:
  Suppress:
    - unknown_template_name
    - unknown_nested_typename_suggest
    - no_member
    - no_member_template
    - typename_nested_not_found
    - invalid_type_template_arg
    - "no type named 'char_traits' in namespace 'std'"
    - "char_traits"
    - "no type named"
  UnusedIncludes: Strict
  MissingIncludes: Strict
  ClangTidy:
    Add: 
      - bugprone-*
      - performance-*
      - cert-*
      - clang-analyzer-*
      - concurrency-*
    Remove:
      - bugprone-easily-swappable-parameters

Hover:
  ShowAKA: true

Completion:
  AllScopes: true

