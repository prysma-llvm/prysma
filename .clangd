# Prysma — strict config for clangd
# The actual build flags are provided
# by CMake via build/compile_commands.json.

CompileFlags:
  CompilationDatabase: build

  Add:
    # Project headers
    - -Iinclude
    - -Ibuild/generationCode/include
    - -I.clangd-includes
    - -Itests/lib
    - -Itests/unit_tests/include

    # External LLVM headers
    # Make sure it matches your LLVM version
    - -isystem.clangd-includes/llvm-18
    - -isystem.clangd-includes/llvm-c-18

    # Strict C++ diagnostics
    - -Wall
    - -Wextra
    - -Wpedantic
    - -Wshadow
    - -Wconversion
    - -Wsign-conversion
    - -Wnull-dereference

Index:
  Background: Build
  StandardLibrary: true

Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

  ClangTidy:
    Add:
      - bugprone-*
      - performance-*
      - cert-*
      - clang-analyzer-*
      - concurrency-*

    Remove:
      - bugprone-easily-swappable-parameters

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  Designators: true
  TypeNameLimit: 0
  BlockEnd: true

Hover:
  ShowAKA: true

Completion:
  AllScopes: true