{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "/workspace/build/Prysma",
            "args": [
                "/workspace/tests/prysma_code_tests/project_test_multi_thread_edge_case_file/test_depth/main.p"
            ],
            "stopAtEntry": false,
            "cwd": "/workspace",
            "environment": [],
            "externalConsole": false,
            "pipeTransport": {
                "pipeCwd": "${workspaceFolder}",
                "pipeProgram": "${workspaceFolder}/docker-cli.sh",
                "pipeArgs": [
                    "run",
                    "-i",
                    "--rm",
                    "--cap-add=SYS_PTRACE",
                    "--security-opt",
                    "seccomp=unconfined",
                    "-v",
                    "${workspaceFolder}:/workspace",
                    "-w",
                    "/workspace",
                    "--entrypoint",
                    "/bin/sh",
                    "prysma-debug",
                    "-c"
                ],
                "debuggerPath": "/usr/bin/gdb"
            },
            "sourceFileMap": {
                "/workspace": "${workspaceFolder}"
            },
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Disable debuginfod",
                    "text": "-gdb-set debuginfod enabled off",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Build"
        }
    ]
}
