{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++: Debug Prysma in Docker (LLDB)",
            "type": "lldb",
            "request": "custom",
            "initCommands": [
                "process handle -s false -p true -n true SIGSTOP",
                "settings set target.source-map /workspace \"${workspaceFolder}\""
            ],
            "targetCreateCommands": [
                "target create \"${workspaceFolder}/build/Prysma\"",
                "settings set target.source-map /workspace \"${workspaceFolder}\""
            ],
            "processCreateCommands": [
                "gdb-remote 127.0.0.1:1234",
                "process handle -s false -p true -n true SIGSTOP"
            ],
            "sourceMap": {
                "/workspace": "${workspaceFolder}"
            },
            "breakpointMode": "file",
            "windows": {
                "breakpointMode": "file",
                "sourceMap": {
                    "/workspace": "${workspaceFolder}"
                },
                "initCommands": [
                    "process handle -s false -p true -n true SIGSTOP",
                    "command source .vscode/lldb_source_map.txt"
                ],
                "targetCreateCommands": [
                    "target create build/Prysma",
                    "command source .vscode/lldb_source_map.txt"
                ],
                "processCreateCommands": [
                    "gdb-remote 127.0.0.1:1234",
                    "process handle -s false -p true -n true SIGSTOP"
                ]
            },
            "preLaunchTask": "Prepare LLDB Debugging",
            "postDebugTask": "Stop LLDB Server (Docker)"
        },
        {
            "name": "C++: Debug Unit Tests in Docker (LLDB)",
            "type": "lldb",
            "request": "custom",
            "initCommands": [
                "process handle -s false -p true -n true SIGSTOP",
                "settings set target.source-map /workspace \"${workspaceFolder}\""
            ],
            "targetCreateCommands": [
                "target create \"${workspaceFolder}/tests/unit_tests/build/PrysmaTests\"",
                "settings set target.source-map /workspace \"${workspaceFolder}\""
            ],
            "processCreateCommands": [
                "gdb-remote 127.0.0.1:1234",
                "process handle -s false -p true -n true SIGSTOP"
            ],
            "sourceMap": {
                "/workspace": "${workspaceFolder}"
            },
            "breakpointMode": "file",
            "windows": {
                "breakpointMode": "file",
                "sourceMap": {
                    "/workspace": "${workspaceFolder}"
                },
                "initCommands": [
                    "process handle -s false -p true -n true SIGSTOP",
                    "command source .vscode/lldb_source_map.txt"
                ],
                "targetCreateCommands": [
                    "target create tests/unit_tests/build/PrysmaTests",
                    "command source .vscode/lldb_source_map.txt"
                ],
                "processCreateCommands": [
                    "gdb-remote 127.0.0.1:1234",
                    "process handle -s false -p true -n true SIGSTOP"
                ]
            },
            "preLaunchTask": "Prepare Unit Test Debugging",
            "postDebugTask": "Stop LLDB Server (Docker)"
        },
        {
            "name": "Python: Debug in Docker",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/workspace"
                }
            ],
            "justMyCode": false,
            "preLaunchTask": "Prepare Python Debugging",
            "postDebugTask": "Stop Python Debug Server (Docker)"
        }
    ]
}
