{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-Command"
                ]
            }
        }
    },
    "tasks": [
        {
            "label": "Compile Prysma Program",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/linux/docker-cli.sh\" run --rm --user $(id -u):$(id -g) -e HOME=/tmp -e CCACHE_DIR=/tmp/.ccache -v prysma-ccache:/tmp/.ccache -v \"${workspaceFolder}\":/workspace -w /workspace prysma-debug /workspace/build/Prysma \"${relativeFile}\"",
            "windows": {
                "command": "& \"${workspaceFolder}/docker/windows/docker-cli.ps1\" -- run --rm -e HOME=/tmp -e CCACHE_DIR=/tmp/.ccache -v prysma-ccache:/tmp/.ccache -v \"${workspaceFolder}:/workspace\" -w /workspace prysma-debug /workspace/build/Prysma \"${relativeFile}\""
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false,
                "focus": true
            },
            "problemMatcher": {
                "owner": "prysma_language",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^([^:]+):(\\d+):(\\d+):\\s+(?:Error|error|warning):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            }
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/linux/docker-cli.sh\" run --rm --user $(id -u):$(id -g) -e HOME=/tmp -e CCACHE_DIR=/tmp/.ccache -v prysma-ccache:/tmp/.ccache -v \"${workspaceFolder}\":/workspace -w /workspace prysma-debug python3 debug.py",
            "windows": {
                "command": "& \"${workspaceFolder}/docker/windows/docker-cli.ps1\" -- run --rm -e HOME=/tmp -e CCACHE_DIR=/tmp/.ccache -v prysma-ccache:/tmp/.ccache -v \"${workspaceFolder}:/workspace\" -w /workspace prysma-debug python3 debug.py"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Start Python Debug Server (Docker)",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/linux/docker-debug-python.sh\" \"${relativeFile}\"",
            "windows": {
                "command": "& \"${workspaceFolder}/docker/windows/docker-debug-python.ps1\" -- \"${relativeFile}\""
            },
            "presentation": {
                "reveal": "never",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Stop Python Debug Server (Docker)",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/linux/docker-stop-python.sh\"",
            "windows": {
                "command": "& \"${workspaceFolder}/docker/windows/docker-stop-python.ps1\""
            },
            "presentation": {
                "reveal": "never",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Debug Python with pdb (Docker)",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/linux/docker-cli.sh\" run --rm -it --user $(id -u):$(id -g) -e HOME=/tmp -v \"${workspaceFolder}\":/workspace -w /workspace prysma-debug python3 -m pdb \"${relativeFile}\"",
            "windows": {
                "command": "& \"${workspaceFolder}/docker/windows/docker-cli.ps1\" -- run --rm -it -e HOME=/tmp -v \"${workspaceFolder}:/workspace\" -w /workspace prysma-debug python3 -m pdb \"${relativeFile}\""
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run Python (Docker)",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/linux/docker-cli.sh\" run --rm --user $(id -u):$(id -g) -e HOME=/tmp -v \"${workspaceFolder}\":/workspace -w /workspace prysma-debug python3 \"${relativeFile}\"",
            "windows": {
                "command": "& \"${workspaceFolder}/docker/windows/docker-cli.ps1\" -- run --rm -e HOME=/tmp -v \"${workspaceFolder}:/workspace\" -w /workspace prysma-debug python3 \"${relativeFile}\""
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": []
        },
        {
            "label": "Start LLDB Server (Docker)",
            "type": "shell",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build"
            ],
            "command": "\"${workspaceFolder}/docker/linux/docker-debug-lldb.sh\" \"${relativeFile}\"",
            "windows": {
                "command": "& \"${workspaceFolder}/docker/windows/docker-debug-lldb.ps1\" -- \"${relativeFile}\""
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": "^(?!.*)$",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*lldb-server ready.*$",
                    "endsPattern": "^.*lldb-server ready.*$"
                }
            }
        },
        {
            "label": "Build Unit Tests",
            "type": "shell",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build"
            ],
            "command": "\"${workspaceFolder}/docker/linux/docker-cli.sh\" run --rm --user $(id -u):$(id -g) -e HOME=/tmp -e CCACHE_DIR=/tmp/.ccache -v prysma-ccache:/tmp/.ccache -v \"${workspaceFolder}\":/workspace -w /workspace/tests/unit_tests prysma-debug sh -c \"cmake -S . -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && cmake --build build -j \\$(nproc)\"",
            "windows": {
                "command": "& \"${workspaceFolder}/docker/windows/docker-cli.ps1\" -- run --rm -e HOME=/tmp -e CCACHE_DIR=/tmp/.ccache -v prysma-ccache:/tmp/.ccache -v \"${workspaceFolder}:/workspace\" -w /workspace/tests/unit_tests prysma-debug sh -c 'cmake -S . -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && cmake --build build -j $(nproc)'"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Start LLDB Server for Unit Tests (Docker)",
            "type": "shell",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Unit Tests"
            ],
            "command": "\"${workspaceFolder}/docker/linux/docker-debug-lldb-tests.sh\"",
            "windows": {
                "command": "& \"${workspaceFolder}/docker/windows/docker-debug-lldb-tests.ps1\""
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": "^(?!.*)$",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*lldb-server ready.*$",
                    "endsPattern": "^.*lldb-server ready.*$"
                }
            }
        }
    ]
}
