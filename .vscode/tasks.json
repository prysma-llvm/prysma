{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "powershell.exe",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-Command"
                ]
            }
        }
    },
    "tasks": [
        {
            "label": "Compile Prysma Program",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/environnement_dev/linux/docker-cli.sh\" run --rm --user $(id -u):$(id -g) -e HOME=/tmp -e CCACHE_DIR=/tmp/.ccache -v prysma-ccache:/tmp/.ccache -v \"${workspaceFolder}\":/workspace -w /workspace prysma-debug /workspace/build/Prysma \"${relativeFile}\"",
            "windows": {
                "command": "& ./docker/environnement_dev/windows/docker-cli.ps1 -- run --rm -e HOME=/tmp -e CCACHE_DIR=/tmp/.ccache -v prysma-ccache:/tmp/.ccache -v ($PWD.Path + ':/workspace') -w /workspace prysma-debug /workspace/build/Prysma $env:PRYSMA_TASK_FILE"
            },
            "group": {
                "kind": "build",
                "isDefault": "**/*.p"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": false,
                "focus": true
            },
            "problemMatcher": {
                "owner": "prysma_language",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+):\\s+(?:Error|error|warning):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            },
            "options": {
                "env": {
                    "PRYSMA_TASK_FILE": "${relativeFile}"
                }
            }
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/environnement_dev/linux/docker-cli.sh\" run --rm --user $(id -u):$(id -g) -e HOME=/tmp -e CCACHE_DIR=/tmp/.ccache -v prysma-ccache:/tmp/.ccache -v \"${workspaceFolder}\":/workspace -w /workspace prysma-debug python3 debug.py",
            "windows": {
                "command": "& ./docker/environnement_dev/windows/docker-cli.ps1 -- run --rm -e HOME=/tmp -e CCACHE_DIR=/tmp/.ccache -v prysma-ccache:/tmp/.ccache -v ($PWD.Path + ':/workspace') -w /workspace prysma-debug python3 debug.py"
            },
            "group": {
                "kind": "build",
                "isDefault": "**/*.{c,cc,cpp,cxx,h,hpp}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Start Python Debug Server (Docker)",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/environnement_dev/linux/docker-debug-python.sh\" \"${relativeFile}\"",
            "windows": {
                "command": "& ./docker/environnement_dev/windows/docker-debug-python.ps1 -- $env:PRYSMA_TASK_FILE"
            },
            "presentation": {
                "reveal": "never",
                "panel": "shared"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(?!)$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^debugpy server starting",
                    "endsPattern": "^debugpy server ready on "
                }
            },
            "isBackground": true,
            "options": {
                "env": {
                    "PRYSMA_TASK_FILE": "${relativeFile}"
                }
            }
        },
        {
            "label": "Stop Python Debug Server (Docker)",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/environnement_dev/linux/docker-debug-python.sh\" --stop",
            "windows": {
                "command": "& ./docker/environnement_dev/windows/docker-debug-python.ps1 -- --stop"
            },
            "presentation": {
                "reveal": "never",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Debug Python with pdb (Docker)",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/environnement_dev/linux/docker-cli.sh\" run --rm -it --user $(id -u):$(id -g) -e HOME=/tmp -v \"${workspaceFolder}\":/workspace -w /workspace prysma-debug python3 -m pdb \"${relativeFile}\"",
            "windows": {
                "command": "& ./docker/environnement_dev/windows/docker-cli.ps1 -- run --rm -it -e HOME=/tmp -v ($PWD.Path + ':/workspace') -w /workspace prysma-debug python3 -m pdb $env:PRYSMA_TASK_FILE"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": [],
            "options": {
                "env": {
                    "PRYSMA_TASK_FILE": "${relativeFile}"
                }
            }
        },
        {
            "label": "Run Python (Docker)",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/environnement_dev/linux/docker-cli.sh\" run --rm --user $(id -u):$(id -g) -e HOME=/tmp -v \"${workspaceFolder}\":/workspace -w /workspace prysma-debug python3 \"${relativeFile}\"",
            "windows": {
                "command": "& ./docker/environnement_dev/windows/docker-cli.ps1 -- run --rm -e HOME=/tmp -v ($PWD.Path + ':/workspace') -w /workspace prysma-debug python3 $env:PRYSMA_TASK_FILE"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": [],
            "options": {
                "env": {
                    "PRYSMA_TASK_FILE": "${relativeFile}"
                }
            }
        },
        {
            "label": "Start LLDB Server (Docker)",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/environnement_dev/linux/docker-debug-lldb.sh\" \"${relativeFile}\"",
            "windows": {
                "command": "& ./docker/environnement_dev/windows/docker-debug-lldb.ps1 -- $env:PRYSMA_TASK_FILE"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": "^(?!.*)$",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^lldb-server starting$",
                    "endsPattern": "^lldb-server ready on [0-9]+$"
                }
            },
            "options": {
                "env": {
                    "PRYSMA_TASK_FILE": "${relativeFile}"
                }
            }
        },
        {
            "label": "Build Unit Tests",
            "type": "shell",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build"
            ],
            "command": "\"${workspaceFolder}/docker/environnement_dev/linux/docker-cli.sh\" run --rm --user $(id -u):$(id -g) -e HOME=/tmp -e CCACHE_DIR=/tmp/.ccache -v prysma-ccache:/tmp/.ccache -v \"${workspaceFolder}\":/workspace -w /workspace/tests/unit_tests prysma-debug sh -c \"cmake -S . -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && cmake --build build -j \\$(nproc)\"",
            "windows": {
                "command": "& ./docker/environnement_dev/windows/docker-cli.ps1 -- run --rm -e HOME=/tmp -e CCACHE_DIR=/tmp/.ccache -v prysma-ccache:/tmp/.ccache -v ($PWD.Path + ':/workspace') -w /workspace/tests/unit_tests prysma-debug sh -c 'cmake -S . -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON && cmake --build build -j $(nproc)'"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Start LLDB Server for Unit Tests (Docker)",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/environnement_dev/linux/docker-debug-lldb.sh\" --tests",
            "windows": {
                "command": "& ./docker/environnement_dev/windows/docker-debug-lldb.ps1 -- --tests"
            },
            "isBackground": true,
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            },
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": "^(?!.*)$",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^lldb-server starting$",
                    "endsPattern": "^lldb-server ready on [0-9]+$"
                }
            }
        },
        {
            "label": "Stop LLDB Server (Docker)",
            "type": "shell",
            "command": "\"${workspaceFolder}/docker/environnement_dev/linux/docker-debug-lldb.sh\" --stop",
            "windows": {
                "command": "& ./docker/environnement_dev/windows/docker-debug-lldb.ps1 -- --stop"
            },
            "problemMatcher": []
        },
        {
            "label": "Prepare LLDB Debugging",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build",
                "Start LLDB Server (Docker)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Prepare Unit Test Debugging",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Build Unit Tests",
                "Start LLDB Server for Unit Tests (Docker)"
            ],
            "problemMatcher": []
        },
        {
            "label": "Prepare Python Debugging",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Start Python Debug Server (Docker)"
            ],
            "problemMatcher": []
        }
    ]
}
